  "item": [
    {
      "name": "SIPA Server \u2014 nginx",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"nginx: status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"nginx: no 502/503/504\", () => pm.expect([502,503,504]).to.not.include(pm.response.code));",
              "pm.test(\"nginx: response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(parseInt(pm.environment.get('LATENCY_WARN_MS') || '3000')));",
              "pm.test(\"nginx: response time < 5000ms (degraded)\", () => pm.expect(pm.response.responseTime).to.be.below(parseInt(pm.environment.get('LATENCY_CRIT_MS') || '5000')));",
              "pm.test(\"nginx: Content-Type header present\", () => pm.expect(pm.response.headers.get('content-type')).to.exist);",
              "pm.test(\"nginx: CF-RAY header present (tunnel active)\", () => pm.expect(pm.response.headers.get('cf-ray')).to.exist);",
              "pm.test(\"nginx: response body not empty\", () => pm.expect(pm.response.text()).to.not.be.empty);",
              "console.log(\"nginx:\", pm.response.code, pm.response.responseTime + \"ms\");"
            ]
          }
        }
      ],
