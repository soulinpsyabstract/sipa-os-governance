  "event": [
    {
      "listen": "prerequest",
      "script": {
        "id": "92c32e1a-8388-4a43-b45e-28e1b8203efb",
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "// \u2500\u2500 SIPA Node Monitors \u2014 Aggregator Init \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
          "// Runs once before the first request in the collection run.",
          "// We use collectionVariables to accumulate results across requests.",
          "",
          "var existing = pm.collectionVariables.get(\"sipa_results\");",
          "if (!existing) {",
          "    pm.collectionVariables.set(\"sipa_results\", JSON.stringify([]));",
          "    pm.collectionVariables.set(\"sipa_run_start\", new Date().toISOString());",
          "    console.log(\"\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\");",
          "    console.log(\"  SIPA OS \u2014 Node Health Check Started\");",
          "    console.log(\"  \" + new Date().toUTCString());",
          "    console.log(\"\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\");",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// \u2500\u2500 SIPA Node Monitors \u2014 Final Aggregated Summary + Uptime History \u2500\u2500",
          "// Fires after every request. Auto-collects result, prints report once all nodes reported.",
          "",
          "var TOTAL_NODES = 6;",
          "var HISTORY_WINDOW = 20;",
          "",
          "// \u2500\u2500 Auto-collect current request result \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
          "var raw = pm.collectionVariables.get(\"sipa_results\");",
          "var results = raw ? JSON.parse(raw) : [];",
          "",
          "var nameMap = {",
          "    \"SIPA Server \u2014 nginx\":           \"nginx\",",
          "    \"SIPA Server \u2014 MCP\":             \"MCP\",",
          "    \"SIPA Server \u2014 WS Gateway\":      \"WS Gateway\",",
          "    \"SIPA Node \u2014 T15\":               \"T15\",",
          "    \"SIPA Node \u2014 X7\":                \"X7\",",
          "    \"SIPA Games \u2014 Frontend\":          \"Games Frontend\"",
          "};",
          "",
          "var shortName = nameMap[pm.info.requestName] || pm.info.requestName;",
          "var allPassed = (pm.test.results && pm.test.results.length) ? pm.test.results.every(function(t) { return t.passed; }) : (pm.response.code < 400 || pm.response.code === 401 || pm.response.code === 426);",
          "var failedTests = (pm.test.results || []).filter(function(t) { return !t.passed; }).map(function(t) { return t.name; });"
        ]
      }
    }
