      "name": "SIPA Server \u2014 WS Gateway",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"WS Gateway: server alive (200 or 426)\", () => pm.expect([200,426]).to.include(pm.response.code));",
              "pm.test(\"WS Gateway: no 502/503/504 (tunnel up)\", () => pm.expect([502,503,504]).to.not.include(pm.response.code));",
              "pm.test(\"WS Gateway: response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(parseInt(pm.environment.get('LATENCY_WARN_MS') || '3000')));",
              "pm.test(\"WS Gateway: response time < 5000ms (degraded)\", () => pm.expect(pm.response.responseTime).to.be.below(parseInt(pm.environment.get('LATENCY_CRIT_MS') || '5000')));",
              "pm.test(\"WS Gateway: CF-RAY header present (tunnel active)\", () => pm.expect(pm.response.headers.get('cf-ray')).to.exist);",
              "pm.test(\"WS Gateway: no 5xx crash\", () => pm.expect(pm.response.code).to.be.below(500));",
              "console.log(\"WS:\", pm.response.code, pm.response.responseTime + \"ms \u2014 426=normal for WS endpoint\");"
            ]
          }
        }
      ],
