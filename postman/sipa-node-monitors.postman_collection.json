    {
      "name": "SIPA Server \u2014 MCP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"MCP: service alive (200 or 401)\", () => pm.expect([200,401]).to.include(pm.response.code));",
              "pm.test(\"MCP: no 502/503/504 (tunnel up)\", () => pm.expect([502,503,504]).to.not.include(pm.response.code));",
              "pm.test(\"MCP: response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(parseInt(pm.environment.get('LATENCY_WARN_MS') || '3000')));",
              "pm.test(\"MCP: response time < 5000ms (degraded)\", () => pm.expect(pm.response.responseTime).to.be.below(parseInt(pm.environment.get('LATENCY_CRIT_MS') || '5000')));",
              "pm.test(\"MCP: Content-Type is JSON\", () => pm.expect(pm.response.headers.get('content-type')).to.include('application/json'));",
              "pm.test(\"MCP: CF-RAY header present (tunnel active)\", () => pm.expect(pm.response.headers.get('cf-ray')).to.exist);",
              "pm.test(\"MCP: response body is valid JSON\", () => { pm.response.json(); });",
              "console.log(\"MCP:\", pm.response.code, pm.response.responseTime + \"ms\");"
            ]
          }
        }
      ],
